# Anthropic key — used by the server proxy in /api/anthropic.js (Pairings + photo-scan)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Supabase — accounts + database. Get these in your Supabase project:
# Settings → Data API (or Project Settings → API): Project URL and the anon/public key.
# NOTE: these MUST start with VITE_ so the app can read them in the browser. The anon
# key is safe to expose; your data is protected by Row Level Security, not by hiding it.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
